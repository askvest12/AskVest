{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Idempotency": {
    "RetentionHours": 24,
    "LockSeconds": 60,
    "MaxStoredResponseBytes": 262144
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Strict": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "RequestLimits": {
    "MaxBodyBytes": 1048576,
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Docs": {
    "Enabled": false
  },
  "Diagnostics": {
    "EnableProbes": false
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
