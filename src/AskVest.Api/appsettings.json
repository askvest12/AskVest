{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Idempotency": {
    "RetentionHours": 24,
    "LockSeconds": 60,
    "MaxStoredResponseBytes": 262144
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Strict": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "RequestLimits": {
    "MaxBodyBytes": 1048576,
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Docs": {
    "Enabled": false
  },
  "Diagnostics": {
    "EnableProbes": false
  },
  "Trading": {
    "BuyEnabled": true,
    "SellEnabled": true,
    "QuoteLifetimeSeconds": 30,
    "MaxQuoteDeviationPercent": 3,
    "FeeBasisPoints": 0,
    "MinOrderAmount": 5,
    "MaxOrderAmount": 1000,
    "Rolling24HourMax": 2000,
    "MaxNonFinalOrders": 5,
    "QuotesPerUserPerMinute": 30,
    "ProgressIntervalSeconds": 5,
    "SubmissionStuckSeconds": 60,
    "SubmittedTimeoutSeconds": 900,
    "GatewayTimeoutSeconds": 10,
    "Gateway": {
      "Routes": {}
    },
    "Fake": {
      "Scenario": "normal",
      "FillDelaySeconds": 2,
      "SubmitDelaySeconds": 3,
      "SpreadPercent": 0.5,
      "GatewayFeeAmount": 0
    }
  },
  "Wallets": {
    "AddressCoolingOffHours": 24,
    "AddressBookMaximum": 10,
    "PreviewLifetimeSeconds": 60,
    "WithdrawalMinQuantity": 0.000001,
    "MaxWithdrawalValueUsd": 500,
    "Rolling24HourMaxValueUsd": 2000,
    "DefaultDustMinimum": 0.000001,
    "DepositIntervalSeconds": 10,
    "ProgressIntervalSeconds": 10,
    "SubmissionStuckSeconds": 60,
    "SubmittedTimeoutSeconds": 900,
    "ProviderTimeoutSeconds": 10,
    "ReservesIntervalMinutes": 10,
    "ReservesMismatchThreshold": 2,
    "Custody": {
      "Routes": []
    },
    "Screening": {
      "Provider": "fake"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
